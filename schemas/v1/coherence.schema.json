{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aantenore/truthlease/main/schemas/v1/coherence.schema.json",
  "title": "TruthLease Coherence Contract v1",
  "oneOf": [
    { "$ref": "#/$defs/observation" },
    { "$ref": "#/$defs/artifact" },
    { "$ref": "#/$defs/lease" },
    { "$ref": "#/$defs/assuranceEvidence" },
    { "$ref": "#/$defs/gateDecision" }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*:[A-Za-z0-9._~+/=-]+$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "revision"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dependency_id", "expected_digest", "required"],
      "properties": {
        "kind": { "enum": ["observation", "artifact"] },
        "dependency_id": { "type": "string", "minLength": 1 },
        "expected_digest": { "$ref": "#/$defs/digest" },
        "expected_version": { "type": ["string", "null"] },
        "expected_generation": { "type": ["integer", "null"], "minimum": 1 },
        "expected_revision": { "type": ["integer", "null"], "minimum": 1 },
        "required": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "observation" } } },
          "then": {
            "required": ["expected_version", "expected_generation"],
            "properties": {
              "expected_version": { "type": "string", "minLength": 1 },
              "expected_generation": { "type": "integer", "minimum": 1 },
              "expected_revision": { "type": "null" }
            }
          },
          "else": {
            "required": ["expected_revision"],
            "properties": {
              "expected_version": { "type": "null" },
              "expected_generation": { "type": "null" },
              "expected_revision": { "type": "integer", "minimum": 1 }
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "version",
        "digest",
        "generation",
        "observed_at",
        "status",
        "source"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "generation": { "type": "integer", "minimum": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "valid_until": { "type": ["string", "null"], "format": "date-time" },
        "status": { "enum": ["current", "disputed", "unknown", "revoked"] },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "kind",
        "payload_digest",
        "dependencies",
        "completeness",
        "status",
        "reconcile_action",
        "created_at"
      ],
      "properties": {
        "ref": { "$ref": "#/$defs/artifactRef" },
        "kind": { "type": "string", "minLength": 1 },
        "payload_digest": { "$ref": "#/$defs/digest" },
        "payload_ref": { "type": ["string", "null"] },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "completeness": { "enum": ["unknown", "declared", "observed"] },
        "status": { "enum": ["fresh", "stale", "disputed", "unknown", "revoked"] },
        "reconcile_action": { "enum": ["block", "notify", "recompute", "replan", "human"] },
        "created_at": { "type": "string", "format": "date-time" },
        "invalidated_at": { "type": ["string", "null"], "format": "date-time" },
        "invalidation_reason": { "type": ["string", "null"] }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version", "generation", "digest"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "artifact",
        "artifact_digest",
        "effect_digest",
        "target",
        "operation",
        "required_assurance",
        "dependency_completeness",
        "closure_digest",
        "snapshot",
        "issued_at",
        "expires_at",
        "boot_epoch",
        "status"
      ],
      "properties": {
        "lease_id": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/artifactRef" },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "effect_digest": { "$ref": "#/$defs/digest" },
        "target": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "required_assurance": { "enum": ["declared", "observed", "revalidated", "fenced"] },
        "dependency_completeness": { "enum": ["unknown", "declared", "observed"] },
        "closure_digest": { "$ref": "#/$defs/digest" },
        "snapshot": { "type": "array", "items": { "$ref": "#/$defs/snapshot" } },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "boot_epoch": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "consumed", "expired", "invalidated", "revoked"] },
        "consumed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "assuranceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "authority",
        "evidence_digest",
        "observed_at",
        "lease_id",
        "closure_digest",
        "effect_digest",
        "target",
        "operation"
      ],
      "properties": {
        "level": { "const": "revalidated" },
        "authority": { "type": "string", "minLength": 1 },
        "evidence_digest": { "$ref": "#/$defs/digest" },
        "observed_at": { "type": "string", "format": "date-time" },
        "lease_id": { "type": "string", "minLength": 1 },
        "closure_digest": { "$ref": "#/$defs/digest" },
        "effect_digest": { "$ref": "#/$defs/digest" },
        "target": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 }
      }
    },
    "gateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "code", "lease_id", "assurance", "guarantee"],
      "properties": {
        "allowed": { "type": "boolean" },
        "code": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 },
        "assurance": { "enum": ["declared", "observed", "revalidated", "fenced"] },
        "guarantee": { "type": "string", "minLength": 1 },
        "receipt_id": { "type": ["string", "null"] },
        "changed_dependencies": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
